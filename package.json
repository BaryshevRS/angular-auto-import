{
  "name": "angular-auto-import",
  "displayName": "Angular Auto Import",
  "description": "Intelligent auto-import for Angular standalone components, directives & pipes. Fix all missing imports with one command. Works with templates, external libraries & monorepos.",
  "publisher": "baryshevrs",
  "version": "2.7.0",
  "icon": "img/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "angular",
    "auto-import",
    "standalone",
    "component",
    "directive",
    "pipe",
    "quick fix",
    "fix all",
    "autocomplete",
    "intellisense",
    "import",
    "missing imports",
    "template",
    "html",
    "typescript",
    "nx",
    "monorepo",
    "refactor",
    "productivity",
    "code action",
    "angular 18",
    "angular 19",
    "angular 20",
    "angular 21",
    "angular 22"
  ],
  "activationEvents": [
    "workspaceContains:angular.json",
    "workspaceContains:nx.json",
    "onLanguage:html",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/BaryshevRS/angular-auto-import.git"
  },
  "bugs": {
    "url": "https://github.com/BaryshevRS/angular-auto-import/issues"
  },
  "homepage": "https://github.com/BaryshevRS/angular-auto-import#readme",
  "license": "MIT",
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/baryshevrs.angular-auto-import?style=flat-square&label=VS%20Marketplace",
      "href": "https://marketplace.visualstudio.com/items?itemName=baryshevrs.angular-auto-import",
      "description": "Visual Studio Marketplace Version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/baryshevrs.angular-auto-import?style=flat-square&label=Installs",
      "href": "https://marketplace.visualstudio.com/items?itemName=baryshevrs.angular-auto-import",
      "description": "Total Installs"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/r/baryshevrs.angular-auto-import?style=flat-square&label=Rating",
      "href": "https://marketplace.visualstudio.com/items?itemName=baryshevrs.angular-auto-import&ssr=false#review-details",
      "description": "Marketplace Rating"
    }
  ],
  "contributes": {
    "commands": [
      {
        "command": "angular-auto-import.reindex",
        "title": "Angular Auto Import: Reindex Project(s)",
        "category": "Angular Auto Import"
      },
      {
        "command": "angular-auto-import.clearCache",
        "title": "Angular Auto Import: Clear Cache",
        "category": "Angular Auto Import"
      },
      {
        "command": "angular-auto-import.showLogs",
        "title": "Show Logs",
        "category": "Angular Auto Import",
        "icon": "$(output)"
      },
      {
        "command": "angular-auto-import.showPerformanceMetrics",
        "title": "Show Performance Metrics (Debug)",
        "category": "Angular Auto Import",
        "icon": "$(graph)"
      },
      {
        "command": "angular-auto-import.fix-all",
        "title": "Angular Auto Import: Fix all missing imports in current file",
        "category": "Angular Auto Import",
        "icon": "$(check-all)"
      },
      {
        "command": "angular-auto-import.generateDiagnosticsReport",
        "title": "Generate Diagnostics Report (Debug)",
        "category": "Angular Auto Import",
        "icon": "$(file-text)"
      }
    ],
    "configuration": {
      "title": "Angular Auto Import",
      "properties": {
        "angular-auto-import.projectPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional. Absolute path to the Angular project root. If set, overrides workspace folders. If not set, uses open workspace folders."
        },
        "angular-auto-import.index.refreshInterval": {
          "type": "number",
          "default": 60,
          "description": "Interval in minutes for automatically reindexing Angular elements. Set to 0 to disable periodic reindexing."
        },
        "angular-auto-import.completion.pipes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-completion suggestions for Angular pipes in templates."
        },
        "angular-auto-import.completion.components.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-completion suggestions for Angular components in templates."
        },
        "angular-auto-import.completion.directives.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-completion suggestions for Angular directives in templates."
        },
        "angular-auto-import.diagnostics.mode": {
          "type": "string",
          "enum": [
            "full",
            "quickfix-only",
            "disabled"
          ],
          "default": "full",
          "description": "Diagnostic mode: 'full' shows diagnostics and provides quick fixes, 'quickfix-only' provides quick fixes without showing diagnostic underlines, 'disabled' turns off all diagnostics."
        },
        "angular-auto-import.diagnostics.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "Severity level for missing directive import diagnostics."
        },
        "angular-auto-import.logging.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the logging system."
        },
        "angular-auto-import.logging.level": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "default": "INFO",
          "description": "Set the logging level."
        },
        "angular-auto-import.logging.fileLoggingEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable logging to a file."
        },
        "angular-auto-import.logging.logDirectory": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "The directory where log files will be stored. If not set, a default directory within the extension's storage path will be used."
        },
        "angular-auto-import.logging.rotationMaxSize": {
          "type": "number",
          "default": 5,
          "description": "The maximum size of a log file in megabytes before it is rotated."
        },
        "angular-auto-import.logging.rotationMaxFiles": {
          "type": "number",
          "default": 5,
          "description": "The maximum number of log files to keep."
        },
        "angular-auto-import.logging.outputFormat": {
          "type": "string",
          "enum": [
            "plain",
            "json"
          ],
          "default": "plain",
          "description": "The format of the logs in the output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "copy-test-fixtures": "cp -r src/test/fixtures out/test/",
    "copy-e2e-cases": "cp -r src/e2e/cases out/e2e/",
    "preclaude": "pnpm run compile-tests && pnpm run copy-test-fixtures && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "pnpm run check:fix && pnpm run lint:knip && pnpm run check-types && pnpm run clone-alert:cpd",
    "lint:biome": "biome lint --diagnostic-level=error --no-errors-on-unmatched src",
    "lint:knip": "knip",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "format:test-projects": "prettier --config src/e2e/projects/.prettierrc --ignore-path src/e2e/projects/.prettierignore --ignore-unknown --write src/e2e/projects",
    "check": "biome check --error-on-warnings src",
    "check:fix": "biome check --write --error-on-warnings src",
    "test": "vscode-test",
    "test:unit": "pnpm run compile-tests && pnpm run copy-test-fixtures && vscode-test --label unit",
    "test:e2e": "pnpm run compile-tests && pnpm run copy-e2e-cases && vscode-test --label e2e",
    "test:e2e:v19": "pnpm run compile-tests && pnpm run copy-e2e-cases && vscode-test --label e2e:v19",
    "test:e2e:v21": "pnpm run compile-tests && pnpm run copy-e2e-cases && vscode-test --label e2e:v21",
    "test:e2e:v22": "pnpm run compile-tests && pnpm run copy-e2e-cases && vscode-test --label e2e:v22",
    "test:e2e:v19:parallel": "pnpm run compile-tests && pnpm run copy-e2e-cases && node scripts/e2e-parallel.mjs v19",
    "test:e2e:v21:parallel": "pnpm run compile-tests && pnpm run copy-e2e-cases && node scripts/e2e-parallel.mjs v21",
    "test:e2e:v22:parallel": "pnpm run compile-tests && pnpm run copy-e2e-cases && node scripts/e2e-parallel.mjs v22",
    "test:generate:v22": "pnpm run compile-tests && pnpm run copy-e2e-cases && vscode-test --label generate:v22",
    "generate:test-projects": "node --import tsx scripts/generate-test-projects.ts",
    "test:coverage": "c8 --experimental-monocart --reporter=v8 --reporter=lcov pnpm run test",
    "coverage:generate": "node scripts/generate-coverage.js",
    "coverage:sonar": "pnpm run coverage:generate && node scripts/sonar-scan.js",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "release": "pnpm run vsce:package && pnpm run vsce:publish",
    "docs:build": "rm -rf docs && typedoc",
    "clone-alert:cpd": "clone-alert --minimum-tokens 100 --files src --extensions .ts --exclude '**/test/**' --exclude '**/e2e/**' --exclude '**/*.test.ts' --format text --fail-on-violation",
    "clone-alert:cpd:json": "clone-alert --minimum-tokens 50 --files src --extensions .ts --exclude '**/test/**' --exclude '**/e2e/**' --exclude '**/*.test.ts' --format json > duplicates-report.json",
    "context:bundle": "repomix --style markdown --output extension-context.md --include \"src/**/*.ts,package.json,CLAUDE.md,tsconfig*.json,biome.json,knip.json,esbuild.js\" --ignore \"src/test/**,node_modules/**,dist/**,out/**,.git/**,**/*.test.ts,**/.DS_Store\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "~20.19.43",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "c8": "^10.1.3",
    "clone-alert": "^0.3.0",
    "esbuild": "^0.25.12",
    "glob": "^11.1.0",
    "knip": "^5.88.1",
    "mocha": "^10.8.2",
    "monocart-coverage-reports": "^2.12.12",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4",
    "repomix": "^1.14.1",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@angular/compiler": "^22.0.1",
    "get-tsconfig": "^4.14.0",
    "p-limit": "7.3.0",
    "ts-morph": "^26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "oxc-resolver"
    ]
  },
  "packageManager": "pnpm@10.32.0"
}
