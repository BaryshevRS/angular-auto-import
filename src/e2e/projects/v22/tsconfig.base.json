{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@alias/*": [
        "apps/angular-demo/src/app/tsconfig-aliases/alias/*"
      ],
      "@angular-demo/app/nx-welcome": [
        "apps/angular-demo/src/app/nx-welcome.component.ts"
      ],
      "@angular-demo/feature-mercury": [
        "libs/mercury/feature-mercury/src/index.ts"
      ],
      "@angular-demo/jupiter-feature": [
        "libs/jupiter/jupiter-feature/src/index.ts"
      ],
      "@angular-demo/ui-demo-one": [
        "libs/core/ui-demo-one/src/index.ts"
      ],
      "@angular-demo/ui-mars": [
        "libs/mars/ui-mars/src/index.ts"
      ],
      "@angular-demo/ui-moon": [
        "libs/moon/src/index.ts"
      ],
      "@dup/left": [
        "apps/angular-demo/src/app/duplicate-modules/left/shared.module.ts"
      ],
      "@dup/right": [
        "apps/angular-demo/src/app/duplicate-modules/right/shared.module.ts"
      ],
      "@deep-alias": [
        "apps/angular-demo/src/app/tsconfig-aliases/deep-alias/deep-alias.component.ts"
      ],
      "@shared/*": [
        "libs/shared-scope/*"
      ],
      "@wild/*": [
        "apps/angular-demo/src/app/alias-scope/wild/*/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
